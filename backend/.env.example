# Copy to .env and adjust. SQLite is the zero-setup default; use Postgres for prod.
DATABASE_URL=sqlite:///./research_chat.db
# DATABASE_URL=postgresql+psycopg2://research:research@localhost:5432/research_chat

# Comma-separated allowed browser origins (Railway/Vercel/etc.)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://multi-llm-chat-sandy.vercel.app

MAX_CONTEXT_TURNS=8
MAX_CONTEXT_TOKENS=12000
MAX_OUTPUT_TOKENS=1024
SUMMARIZE_AFTER_TURNS=16

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
CODECRAFT_API_KEY=
CODECRAFT_BASE_URL=https://codecraftapi.com/v1
